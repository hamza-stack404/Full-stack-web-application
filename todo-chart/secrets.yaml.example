# Kubernetes Secrets Configuration Example
#
# IMPORTANT: This file is a template. DO NOT commit actual secrets!
#
# Usage:
# 1. Copy this file: cp secrets.yaml.example secrets.yaml
# 2. Fill in your actual secret values in secrets.yaml
# 3. Ensure secrets.yaml is in .gitignore
# 4. Deploy with: helm install todo-app ./todo-chart -f secrets.yaml

secrets:
  # PostgreSQL connection string
  # Format: postgresql://username:password@host:port/database?sslmode=require
  # Example: postgresql://user:pass@ep-example.aws.neon.tech/mydb?sslmode=require
  databaseUrl: "YOUR_DATABASE_URL_HERE"

  # Gemini API keys (comma-separated for rotation)
  # Get from: https://makersuite.google.com/app/apikey
  # Example: AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,AIzaSyYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
  geminiApiKeys: "YOUR_GEMINI_API_KEYS_HERE"

  # Authentication secret (generate a strong random string)
  # Generate with: openssl rand -base64 32
  betterAuthSecret: "YOUR_AUTH_SECRET_HERE"
